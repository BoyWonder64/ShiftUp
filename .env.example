# Copy this file to .env and adjust as needed.

# Privileged role - used only for running migrations (prisma.config.ts).
# Local: matches docker-compose.yml. In Azure, this is the Postgres Flexible Server admin connection string.
DATABASE_URL="postgresql://shiftup:shiftup_dev_password@localhost:5432/shiftup?schema=public"

# Restricted, non-superuser role - used by the running app (src/lib/prisma.ts).
# Created by prisma/migrations/*_add_restricted_app_role. This is the role Row-Level
# Security actually applies to; the privileged role above bypasses RLS entirely.
APP_DATABASE_URL="postgresql://shiftup_app:shiftup_app_dev_password@localhost:5432/shiftup?schema=public"

# Session/auth signing secret. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Stripe (platform's own account - tenant license purchases, NOT client-pays-
# business, which will use per-tenant Stripe Connect later). Test-mode keys
# from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=""
# From `stripe listen --forward-to localhost:3000/api/billing/webhook` locally,
# or the webhook endpoint's signing secret in the Stripe Dashboard in production.
STRIPE_WEBHOOK_SECRET=""

# One-time setup secret for POST /api/superadmin/bootstrap, which creates the
# platform's own SUPERADMIN (dev console) account - there's no public signup
# for this role. Generate with: openssl rand -base64 32
# Leave unset to disable the bootstrap route entirely (it 404s without this).
# The route self-disables once a SUPERADMIN account exists, regardless.
SUPERADMIN_SETUP_SECRET=""

# Transactional email (src/lib/email.ts) - currently the "Forgot password?"
# flow only (src/app/api/auth/password-reset/**). Backed by Resend
# (https://resend.com - free tier, no card required for a test account).
# Get an API key from https://resend.com/api-keys.
RESEND_API_KEY=""
# Must be a verified sending identity in your Resend account. For local dev
# without a verified domain, Resend's shared test domain works:
# EMAIL_FROM="ShiftUp <onboarding@resend.dev>" - but it can only send to the
# email address on your own Resend account, not arbitrary recipients, so
# real cross-account testing needs a verified domain even in dev. Swap this
# whole file (src/lib/email.ts) for SMTP or another provider later without
# touching any of its callers.
EMAIL_FROM=""
