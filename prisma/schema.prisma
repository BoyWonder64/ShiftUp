// Phase 0: Tenancy, auth, and licensing models.
// Phase 1 (added below): core scheduling - ServiceType, StaffProfile,
// WorkingHours, Client, Appointment, plus the double-booking EXCLUDE
// constraint (see the add_appointment_exclusion_constraint migration).
// Notes/holidays/time-off/payments are added in later phases per the
// architecture plan (see plans/i-would-like-to-encapsulated-crayon.md) and
// PROGRESS.md for changes made after that plan was written.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// SUPERADMIN (platform operator, tenantId null) and ADMIN (tenant owner) are
/// the only two fixed roles - both bypass the configurable permission system
/// entirely and are hardcoded throughout the app (billing, Settings access,
/// etc.). Everyone else is STAFF, whose actual role is a tenant-defined `Role`
/// row referenced by `User.roleId` - tenants can create, rename, and delete
/// their own roles freely (see the Role model) rather than picking from a
/// fixed list, since this product spans very different industries (a police
/// department and a plumbing company have nothing in common role-wise).
enum UserRole {
  SUPERADMIN
  ADMIN
  STAFF

  @@map("user_role")
}

/// Whether a license is currently entitled. FREE licenses are always ACTIVE
/// (no expiry, no ticking trial clock) - EXPIRED only applies to a lapsed
/// SUBSCRIPTION (see BillingPlan).
enum LicenseStatus {
  ACTIVE
  EXPIRED

  @@map("license_status")
}

/// Which product module(s) a tenant has access to. SHIFT_MANAGEMENT and
/// APPOINTMENT_MANAGER can run standalone or together (BOTH) in the same
/// deployment - see src/lib/licensing/features.ts for the runtime feature gate
/// this drives. Orthogonal to BillingPlan: a tenant can explore any feature
/// tier for free, same as a paying one - the limit is usage caps
/// (src/lib/licensing/limits.ts), not which modules are visible.
enum LicenseTier {
  SHIFT_MANAGEMENT
  APPOINTMENT_MANAGER
  BOTH

  @@map("license_tier")
}

/// How the tenant is paying, separate from which features they get:
/// - FREE: permanent, usage-capped (src/lib/licensing/limits.ts) - the "explore
///   the product" tier, not a time-limited trial.
/// - ONE_TIME: a single purchase, lifetime access, no usage caps.
/// - SUBSCRIPTION: recurring (Stripe Subscription), lifetime-while-current,
///   no usage caps. EXPIRED status means the subscription lapsed.
/// Checkout for ONE_TIME/SUBSCRIPTION isn't built yet (Phase 3) - every
/// signup currently gets FREE regardless of which feature tier they pick.
enum BillingPlan {
  FREE
  ONE_TIME
  SUBSCRIPTION

  @@map("billing_plan")
}

/// What kind of calendar entry an Appointment row actually is. Replaces the
/// old clientId-presence inference (null = shift, set = appointment) now
/// that there are three real kinds, not two - CUSTOM entries can have a
/// client or not depending on the tenant's own Custom-form settings, so
/// clientId alone can no longer tell SHIFT apart from CUSTOM. Backfilled from
/// the old inference on migration (see the entry_kind migration).
enum EntryKind {
  SHIFT
  APPOINTMENT
  CUSTOM

  @@map("entry_kind")
}

/// What a DashboardMetric actually counts. STAFF_COUNT ignores every other
/// filter field on the row (there's nothing to filter a headcount by yet);
/// APPOINTMENT_COUNT is a generic count over the shared Appointment table,
/// narrowed by entryKindFilter/dateRange/statusFilter below.
enum DashboardMetricType {
  STAFF_COUNT
  APPOINTMENT_COUNT

  @@map("dashboard_metric_type")
}

/// Which slice of time a DashboardMetric's count covers, compared against
/// Appointment.startTime. UPCOMING is today's existing "Upcoming
/// appointments" tile's definition (startTime >= now).
enum DashboardMetricDateRange {
  ALL_TIME
  UPCOMING
  PAST
  TODAY
  THIS_WEEK
  THIS_MONTH

  @@map("dashboard_metric_date_range")
}

/// Which AppointmentStatus value(s) a DashboardMetric's count includes.
/// EXCLUDE_CANCELLED (not one specific status, but an exclusion) is today's
/// existing "Upcoming appointments" tile's definition and the sensible
/// default for a new metric - the other options narrow to exactly one status
/// (including CANCELLED itself, for a tenant that wants to count
/// cancellations specifically) or ANY (no filter at all).
enum DashboardMetricStatusFilter {
  ANY
  EXCLUDE_CANCELLED
  PENDING_PAYMENT
  BOOKED
  COMPLETED
  CANCELLED
  NO_SHOW

  @@map("dashboard_metric_status_filter")
}

/// A tenant is one customer business (a therapy practice, a plumbing company, etc.).
/// All tenant-scoped data carries a tenantId and is additionally isolated at the
/// database level via Postgres Row-Level Security (see prisma/migrations for the RLS policies).
model Tenant {
  id                            String   @id @default(uuid())
  name                          String
  slug                          String   @unique
  timezone                      String   @default("UTC")
  /// Admin-configurable: whether a client must be attached when creating an
  /// appointment. Off by default for tenants that book clientless work
  /// (internal-only visits, pure shift scheduling that still uses the
  /// appointment form) - toggled from the Settings admin page.
  requireClientForAppointments  Boolean  @default(true) @map("require_client_for_appointments")
  /// Admin-configurable: whether an in-person appointment's address shows an
  /// "Open in Google Maps" navigation link. On by default - toggled off for
  /// tenants that don't want that link shown (e.g. privacy preference, or
  /// addresses that aren't real navigable locations).
  enableMapsNavigation          Boolean  @default(true) @map("enable_maps_navigation")
  /// The tenant's company logo, stored as a data: URL (e.g.
  /// "data:image/png;base64,...") rather than a file path - there's no blob
  /// storage wired up in this stack (see PROGRESS.md), and a small logo
  /// comfortably fits in a TEXT column. Null = no logo set. Admin-only to
  /// change (src/app/api/admin/logo/route.ts); shown in AppHeader for
  /// everyone in the tenant.
  logoDataUrl                   String?  @map("logo_data_url")
  /// Admin-configurable: which font the tenant's business name is rendered
  /// in (AppHeader, dashboard heading) - one of the keys in
  /// src/lib/fonts/companyNameFonts.ts. Null = the default body font (no
  /// override). Admin-only to change (src/app/api/admin/company-name-font/route.ts).
  companyNameFont               String?  @map("company_name_font")
  /// Admin-configurable overrides for the 5 built-in event-type colors
  /// (appointment/shift/completed/noShow/cancelled), stored as a flat
  /// {key: "#rrggbb"} JSON object - only keys actually overridden need be
  /// present; `src/lib/colors/eventColors.ts` fills in the rest from the
  /// hardcoded defaults. Kept as JSON rather than 5 separate columns since
  /// it's always read/written as one unit and never queried by individual key.
  eventColors                   Json?    @map("event_colors")
  /// Admin-configurable: names of the computed holidays (US federal + major
  /// European, see src/lib/holidays/catalog.ts - computed, not stored) that
  /// show on the calendar, one checkbox per holiday rather than one toggle
  /// per region. Defaults to just the 11 US federal names - keep in sync
  /// with catalog.ts's `DEFAULT_ENABLED_HOLIDAY_NAMES`.
  enabledHolidayNames           String[] @default(["New Year's Day", "Martin Luther King Jr. Day", "Washington's Birthday", "Memorial Day", "Juneteenth", "Independence Day", "Labor Day", "Columbus Day", "Veterans Day", "Thanksgiving Day", "Christmas Day"]) @map("enabled_holiday_names")
  /// Admin-configurable: which of the *enabled* computed holidays above
  /// should also render as a full-day blocked-time span (see BlockedTime)
  /// instead of just the plain holiday tint - e.g. a business that's fully
  /// closed on Christmas vs. one that just likes the day marked. A name
  /// here with no matching entry in enabledHolidayNames has no effect -
  /// blocking only ever applies on top of a holiday that's actually shown.
  blockedHolidayNames           String[] @default([]) @map("blocked_holiday_names")
  /// Admin-configurable (Settings > "Shift form"): whether the shift
  /// create/detail forms show the job type (ServiceType), job estimate, and
  /// color key fields. On by default (today's existing behavior). Only
  /// affects shift mode - the appointment form's equivalent fields are
  /// unaffected by these.
  showJobTypeOnShiftForm        Boolean  @default(true) @map("show_job_type_on_shift_form")
  showJobEstimateOnShiftForm    Boolean  @default(true) @map("show_job_estimate_on_shift_form")
  showColorKeyOnShiftForm       Boolean  @default(true) @map("show_color_key_on_shift_form")
  /// Admin-configurable (Settings > "Shift form"): whether two shifts for the
  /// same staff member are allowed to overlap in time (e.g. an overlapping
  /// handoff, or someone covering two roles at once). Off by default - the
  /// DB-level appointments_no_overlapping_staff_time EXCLUDE constraint only
  /// ever covered client-having rows (real appointments) to begin with for
  /// shifts this is enforced in application code (createAppointment/
  /// rescheduleAppointment/reassignAppointmentStaff in
  /// src/modules/scheduling/service.ts), not at the DB level, so it can be
  /// switched per tenant. Never applies to appointments (clientId set) -
  /// those stay always-no-overlap via the DB constraint, this setting only
  /// relaxes the rule for clientless shift rows.
  allowOverlappingShifts        Boolean  @default(false) @map("allow_overlapping_shifts")
  /// Admin-configurable (Settings > Calendar): the Week/Day time gutter's
  /// displayed range, as minutes-from-midnight (0-1440, end > start).
  /// Defaults to the full day (0/1440 - today's existing behavior, no visual
  /// change for tenants that never touch this). Purely a *display* bound on
  /// `SchedulingCalendar`'s grid - distinct from the `WorkingHours` model
  /// (which isn't used anywhere yet, see ISSUES.md) and from whether a slot
  /// is actually bookable; this only controls how much of the 24-hour grid
  /// renders at all, so most businesses can hide the dead overnight space
  /// they never use.
  calendarStartMinute           Int      @default(0) @map("calendar_start_minute")
  calendarEndMinute             Int      @default(1440) @map("calendar_end_minute")
  /// Admin-configurable (Settings > Calendar): master on/off switch for
  /// editing an appointment/shift once it's booked - reassigning staff,
  /// rescheduling, changing the client/service/location/price/payment
  /// status, the color key, or the job estimate. Does NOT cover cancelling
  /// (CANCEL_SHIFTS/CANCEL_APPOINTMENTS stays independent - see
  /// src/app/api/appointments/[id]/route.ts) - a tenant can lock bookings
  /// from being altered while still letting them be called off. On by
  /// default (today's existing behavior); EDIT_SHIFTS/EDIT_APPOINTMENTS/
  /// EDIT_JOB_ESTIMATES still apply on top of this when it's on - this is an
  /// extra tenant-wide gate, not a replacement for the per-role permissions.
  allowEditingBookedEvents      Boolean  @default(true) @map("allow_editing_booked_events")
  /// Admin-configurable (Settings > "Appointment form"): whether the
  /// appointment detail panel shows/lets staff edit Appointment.paymentStatus
  /// at all (ISSUES.md #5) - on by default (today's existing display-only
  /// behavior). Off for tenants that don't bill per-appointment and don't
  /// want an always-UNPAID field cluttering the panel. Never applies to
  /// shifts (no client, no price) regardless of this setting.
  showPaymentStatus             Boolean  @default(true) @map("show_payment_status")
  /// Admin-configurable (Settings > Booking Widget, paid feature - see
  /// assertBookingWidgetEnabled): master on/off switch for the public,
  /// unauthenticated self-booking page/embed at /book/<slug>. Off by default -
  /// turning it on is a deliberate choice distinct from just being on a paid
  /// plan, same two-gate pattern as schedule templates (paid tier +
  /// admin-toggleable). See ServiceType.isPubliclyBookable for which services
  /// actually show up once this is on, and WorkingHours for what makes a
  /// staff member's time show as bookable at all.
  publicBookingEnabled          Boolean  @default(false) @map("public_booking_enabled")
  /// Admin-configurable (Settings > Booking Widget): how soon from "now" a
  /// public visitor is allowed to book a slot, in minutes - prevents booking
  /// a slot 2 minutes from now that staff has no chance to see/prepare for.
  publicBookingMinNoticeMinutes Int      @default(120) @map("public_booking_min_notice_minutes")
  /// Admin-configurable (Settings > Booking Widget): how many days into the
  /// future the public booking page shows availability for.
  publicBookingWindowDays       Int      @default(30) @map("public_booking_window_days")
  /// Admin-configurable (Settings > Calendars): tenant-wide on/off switch for
  /// each of Appointments/Shifts, independent of whether the license tier
  /// even includes that module (featuresForTier gates whether a tenant could
  /// ever use it; this is the separate choice to actually show it). Both
  /// default on to preserve today's behavior for existing tenants. The
  /// Custom calendar has no equivalent single toggle - a paid tenant creates
  /// as many named CustomCalendar rows as it wants (see that model); its own
  /// existence is what makes it live (see assertCustomCalendarEnabled, still
  /// required on every create since a FREE-plan tenant can't have any).
  appointmentsCalendarEnabled   Boolean  @default(true) @map("appointments_calendar_enabled")
  shiftsCalendarEnabled         Boolean  @default(true) @map("shifts_calendar_enabled")
  /// SUPERADMIN-only (dev console > Customers): blocks every user of this
  /// tenant from logging in. Checked in POST /api/auth/login only - an
  /// already-active session isn't revoked (sessions are stateless, see
  /// src/lib/auth/session.ts), so a disabled tenant's logged-in users keep
  /// working until their session naturally expires or they log out, same
  /// limitation already flagged for password-reset in TODO.md.
  disabled                      Boolean  @default(false) @map("disabled")
  /// SUPERADMIN-only (dev console > Customers): leaves this tenant's License
  /// out of the Income page's revenue totals/counts - for test/demo/internal
  /// accounts that shouldn't skew real revenue numbers even if they carry a
  /// paid License for feature-testing purposes.
  excludeFromIncome             Boolean  @default(false) @map("exclude_from_income")
  createdAt                     DateTime @default(now()) @map("created_at")
  updatedAt                     DateTime @updatedAt @map("updated_at")

  license License?
  users   User[]

  staffProfiles           StaffProfile[]
  workingHours            WorkingHours[]
  appointmentServiceTypes AppointmentServiceType[]
  shiftServiceTypes       ShiftServiceType[]
  clients                 Client[]
  appointments            Appointment[]
  roles                   Role[]
  rolePermissions         RolePermission[]
  roleVisibilities        RoleVisibility[]
  timeOffs                TimeOff[]
  eventTags               EventTag[]
  holidays                Holiday[]
  blockedTimes            BlockedTime[]
  scheduleTemplates       ScheduleTemplate[]
  scheduleTemplateShifts  ScheduleTemplateShift[]
  customCalendars         CustomCalendar[]
  dashboardMetrics        DashboardMetric[]

  @@map("tenants")
}

/// A tenant-named, admin-configurable dashboard stat tile (Settings >
/// Dashboard) - replaces the old two hardcoded tiles ("Staff"/"Upcoming
/// appointments") with a fully custom list a tenant builds for itself:
/// rename, delete, reorder, and add as many as wanted. See
/// src/modules/dashboard/service.ts's computeMetricValue for how a row here
/// becomes an actual count.
model DashboardMetric {
  id              String                      @id @default(uuid())
  tenantId        String                      @map("tenant_id")
  tenant          Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  label           String
  metricType      DashboardMetricType         @map("metric_type")
  /// Only meaningful when metricType is APPOINTMENT_COUNT. Null means "every
  /// kind together" rather than narrowing to one.
  entryKindFilter EntryKind?                  @map("entry_kind_filter")
  dateRange       DashboardMetricDateRange    @default(ALL_TIME) @map("date_range")
  statusFilter    DashboardMetricStatusFilter @default(EXCLUDE_CANCELLED) @map("status_filter")
  /// Display order on the dashboard - admin-created metrics append in
  /// creation order by default (no drag-reorder UI yet, same as
  /// CustomCalendar.sortOrder).
  sortOrder       Int                         @default(0) @map("sort_order")
  createdAt       DateTime                    @default(now()) @map("created_at")
  updatedAt       DateTime                    @updatedAt @map("updated_at")

  @@index([tenantId])
  @@map("dashboard_metrics")
}

/// A tenant-named, admin-configurable "custom" calendar (Settings >
/// Calendars > "Custom calendars") - a paid-tier tenant can create as many
/// of these as it wants, each with its own name and its own independent
/// field-visibility settings for the create/edit form, mirroring the
/// show/hide shape already used for the Shift form (showJobTypeOnShiftForm
/// etc. on Tenant) but per-calendar instead of tenant-wide. Entries
/// (Appointment rows with entryKind CUSTOM) belong to exactly one of these
/// via customCalendarId - there is no tenant-wide "custom calendar enabled"
/// flag the way Appointments/Shifts have; a calendar simply existing is what
/// makes it live (deleting it is the only way to turn one off), though
/// `assertCustomCalendarEnabled` still gates *creating* one to paid plans.
model CustomCalendar {
  id                      String   @id @default(uuid())
  tenantId                String   @map("tenant_id")
  tenant                  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name                    String
  /// Same show/hide shape as Tenant's showJobTypeOnShiftForm etc. - see that
  /// field's doc comment. showClient/requireClient are a visibility toggle
  /// (not just requiredness) since a custom entry doesn't inherently need a
  /// client the way an appointment does.
  showClient              Boolean  @default(false) @map("show_client")
  requireClient           Boolean  @default(false) @map("require_client")
  showJobType             Boolean  @default(true) @map("show_job_type")
  showJobEstimate         Boolean  @default(true) @map("show_job_estimate")
  showColorKey            Boolean  @default(true) @map("show_color_key")
  showPaymentStatus       Boolean  @default(false) @map("show_payment_status")
  /// Display order in the calendar nav/settings list - admin-created
  /// calendars append in creation order by default (no reorder UI yet).
  sortOrder               Int      @default(0) @map("sort_order")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  appointments Appointment[]

  @@index([tenantId])
  @@map("custom_calendars")
}

/// A tenant-defined role (e.g. "Officer", "Plumber", "Dispatcher") - fully
/// custom per tenant, not picked from a fixed list, since this product spans
/// very different industries. ADMIN/SUPERADMIN are NOT roles in this table -
/// they're fixed, hardcoded, and outside the configurable permission system
/// entirely (see UserRole). Deleting a role is blocked at the DB level
/// (User.roleId's onDelete: Restrict) while any user still holds it.
model Role {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  /// Free-text explanation of what this role is for - shown alongside the
  /// name in Settings. Purely informational, like reportsToId below - it
  /// doesn't affect what the role can actually do (that's RolePermission).
  description String?  @map("description")
  /// The role immediately above this one in the tenant's org chart, if any -
  /// null means nothing is above it. Purely organizational/informational:
  /// permissions are never inherited through this chain, only ever granted
  /// directly via RolePermission. SetNull (not Restrict) on delete - removing
  /// a role just clears anything that reported to it, rather than blocking
  /// the delete or cascading further up the chain.
  reportsToId String?  @map("reports_to_id")
  reportsTo   Role?    @relation("RoleHierarchy", fields: [reportsToId], references: [id], onDelete: SetNull)
  reports     Role[]   @relation("RoleHierarchy")
  createdAt   DateTime @default(now()) @map("created_at")

  users       User[]
  permissions RolePermission[]
  asViewer    RoleVisibility[] @relation("RoleVisibilityViewer")
  asTarget    RoleVisibility[] @relation("RoleVisibilityTarget")

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([reportsToId])
  @@map("roles")
}

/// A custom, tenant-defined color tag (e.g. "VIP", "Consultation") that can
/// be assigned to an individual appointment/shift to override its default
/// status-based color - the per-event counterpart to the tenant-wide
/// eventColors overrides above, which only re-theme the 5 built-in
/// categories rather than adding new ones.
model EventTag {
  id        String        @id @default(uuid())
  tenantId  String        @map("tenant_id")
  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  /// Hex color, e.g. "#2563eb".
  color     String
  /// Which kind of entry this tag can be assigned to - BOTH (default) shows
  /// up on every "Color key" picker, SHIFT/APPOINTMENT only on that one.
  appliesTo EventTagScope @default(BOTH) @map("applies_to")
  createdAt DateTime      @default(now()) @map("created_at")

  appointments Appointment[]

  @@index([tenantId])
  @@map("event_tags")
}

enum EventTagScope {
  SHIFT
  APPOINTMENT
  BOTH

  @@map("event_tag_scope")
}

/// A day the business is closed/observing, shown on the calendar. Federal
/// holidays are computed in code (src/lib/holidays/federal.ts) and never
/// stored here - this table is only for tenant-added custom holidays.
model Holiday {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  date      DateTime @db.Date
  /// If true, this holiday recurs every year on the same month/day
  /// (the `date` column's year is otherwise ignored for display purposes -
  /// still stored as a full date since Postgres has no month/day-only type).
  /// If false, it's a one-off for that exact date.
  recurring Boolean  @default(true)
  /// If true, this holiday also renders as a full-day blocked-time span (see
  /// BlockedTime) instead of just the plain holiday tint - the custom-holiday
  /// equivalent of Tenant.blockedHolidayNames for the computed catalog ones.
  blocked   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@map("holidays")
}

/// A business-wide span of time marked unavailable on the calendar - purely
/// visual (greyed out/striped, see SchedulingCalendar.tsx's backgroundEvents),
/// not a hard constraint: appointments and shifts can still be created over
/// it if someone chooses to. Distinct from Holiday (a single enabled/disabled
/// whole day) in that it's an arbitrary start/end range an admin creates
/// directly, and from TimeOff (per-staff leave) in that it applies to the
/// whole business at once rather than one staff member.
model BlockedTime {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  label     String?
  startTime DateTime @map("start_time")
  endTime   DateTime @map("end_time")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([tenantId, startTime])
  @@map("blocked_time")
}

enum DiscountType {
  PERCENT
  FIXED_CENTS

  @@map("discount_type")
}

/// A dev-managed discount code, created/deactivated from the SUPERADMIN
/// console (src/app/superadmin) for manually quoting/tracking a negotiated
/// discount. Not yet wired into the Stripe checkout flow itself (see
/// TODO.md) - redeeming one against a real purchase is still a manual step
/// for now, same "built but not yet live-integrated" status as checkout
/// overall. Platform-level, not tenant-scoped, so no RLS policy - access is
/// gated entirely at the API layer (SUPERADMIN-only), the same convention
/// already used for the hardcoded ADMIN-only billing checkout route.
model DiscountCode {
  id        String       @id @default(uuid())
  code      String       @unique
  type      DiscountType
  /// PERCENT: 1-100. FIXED_CENTS: a flat amount off, in cents.
  value     Int
  active    Boolean      @default(true)
  createdAt DateTime     @default(now()) @map("created_at")

  @@map("discount_codes")
}

/// A tenant's entitlement: which feature tier (modules) and which billing
/// plan (free/one-time/subscription) they're on. See BillingPlan and
/// LicenseTier above - these two are independent dimensions.
model License {
  id                    String        @id @default(uuid())
  tenantId              String        @unique @map("tenant_id")
  tenant                Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tier                  LicenseTier   @default(BOTH)
  billingPlan           BillingPlan   @default(FREE) @map("billing_plan")
  status                LicenseStatus @default(ACTIVE)
  purchasedAt           DateTime?     @map("purchased_at")
  /// null = lifetime (FREE or ONE_TIME); non-null = SUBSCRIPTION renewal/expiry date
  expiresAt             DateTime?     @map("expires_at")
  stripeCustomerId      String?       @map("stripe_customer_id")
  stripePaymentIntentId String?       @map("stripe_payment_intent_id")
  stripeSubscriptionId  String?       @map("stripe_subscription_id")
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")

  @@map("licenses")
}

/// A user's own display-language preference for the app's UI (not the
/// business's data - a tenant's client-facing content, names, etc. are
/// never translated). Per-user, not per-tenant: two people at the same
/// business can each run the app in a different language. Set from the
/// language picker in AppHeader, applied via next-intl
/// (src/i18n/request.ts reads it off the signed session, which is
/// re-issued on change so the new language takes effect immediately).
enum Locale {
  EN
  ES
  DE
  FR

  @@map("locale")
}

/// A user's own calendar event text-size preference (Settings > Account) -
/// per-user, not per-tenant, same rationale as Locale above. Applied as a CSS
/// variable in SchedulingCalendar.tsx; MEDIUM is the calendar's default
/// (small, dense-by-default) size, with SMALL/LARGE/XLARGE for anyone who
/// wants it smaller still or bigger for readability.
enum CalendarTextSize {
  SMALL
  MEDIUM
  LARGE
  XLARGE

  @@map("calendar_text_size")
}

/// A login-capable user. Platform superadmins have tenantId = null;
/// every other user belongs to exactly one tenant.
model User {
  id               String           @id @default(uuid())
  tenantId         String?          @map("tenant_id")
  tenant           Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email            String           @unique
  locale           Locale           @default(EN)
  calendarTextSize CalendarTextSize @default(MEDIUM) @map("calendar_text_size")
  /// Admin-set at account creation (signup, or whoever adds a staff member) -
  /// nullable only because it was added after email-only login already
  /// existed; every new account is required to set one (see isValidUsername
  /// in src/modules/identity/service.ts). Lets login accept either.
  username         String?          @unique
  passwordHash     String           @map("password_hash")
  role             UserRole         @default(STAFF)
  /// The tenant's custom Role this user holds - set (and required, enforced
  /// in application code, not a DB constraint - same convention as ADMIN's
  /// other code-enforced invariants) whenever `role` is STAFF; always null
  /// for ADMIN/SUPERADMIN, which are fixed roles outside this table.
  /// onDelete: Restrict - a role can't be deleted while anyone still holds
  /// it, by design (the admin must reassign those users first).
  roleId           String?          @map("role_id")
  customRole       Role?            @relation(fields: [roleId], references: [id], onDelete: Restrict)
  /// True only for the account that originally signed up/created the tenant.
  /// Set once at signup, never exposed for write by any route. Not itself
  /// checked at runtime: the owner is created with no StaffProfile and is
  /// never assigned one, so they can never be a `staffProfile.id` target of
  /// the staff promote/demote/delete routes in the first place - this flag
  /// just records who that account is (e.g. for an "Owner" badge), it isn't
  /// load-bearing for that protection.
  isOwner          Boolean          @default(false) @map("is_owner")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  staffProfile     StaffProfile?

  @@index([tenantId])
  @@index([roleId])
  @@map("users")
}

enum AppointmentStatus {
  PENDING_PAYMENT
  BOOKED
  COMPLETED
  CANCELLED
  NO_SHOW

  @@map("appointment_status")
}

enum PaymentStatus {
  UNPAID
  PAID
  WAIVED
  REFUNDED

  @@map("payment_status")
}

enum AppointmentSource {
  SELF_SERVICE
  ADMIN

  @@map("appointment_source")
}

enum MeetingLocationType {
  IN_PERSON
  ONLINE

  @@map("meeting_location_type")
}

/// One staff member's schedulable profile. A User becomes schedulable by
/// getting a StaffProfile - not every User has one (e.g. CUSTOMER never does).
model StaffProfile {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId        String   @unique @map("user_id")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName   String   @map("display_name")
  bufferMinutes Int      @default(0) @map("buffer_minutes")
  timezone      String   @default("UTC")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  workingHours           WorkingHours[]
  appointments           Appointment[]
  timeOffs               TimeOff[]
  scheduleTemplateShifts ScheduleTemplateShift[]

  @@index([tenantId])
  @@map("staff_profiles")
}

enum TimeOffStatus {
  PENDING
  APPROVED
  DENIED

  @@map("time_off_status")
}

/// A staff member's request for time off. Anyone with a StaffProfile can
/// create one for themselves (no permission gate - requesting time off isn't
/// a privileged action); approving/denying someone else's request requires
/// APPROVE_TIME_OFF (src/lib/permissions/catalog.ts). Used by the
/// shift-coverage finder to exclude staff on approved leave from candidates.
model TimeOff {
  id                String        @id @default(uuid())
  tenantId          String        @map("tenant_id")
  tenant            Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staffProfileId    String        @map("staff_profile_id")
  staffProfile      StaffProfile  @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)
  startTime         DateTime      @map("start_time")
  endTime           DateTime      @map("end_time")
  reason            String?
  status            TimeOffStatus @default(PENDING)
  requestedByUserId String        @map("requested_by_user_id")
  reviewedByUserId  String?       @map("reviewed_by_user_id")
  reviewedAt        DateTime?     @map("reviewed_at")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([staffProfileId, startTime])
  @@map("time_off")
}

/// A recurring weekly availability window. dayOfWeek: 0=Sunday .. 6=Saturday.
/// start/endMinute are minutes since local midnight, in the staff's own
/// timezone - converted to UTC instants only when computing actual slots
/// against a specific calendar date (see modules/scheduling/availability.ts).
model WorkingHours {
  id             String       @id @default(uuid())
  tenantId       String       @map("tenant_id")
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staffProfileId String       @map("staff_profile_id")
  staffProfile   StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)
  dayOfWeek      Int          @map("day_of_week")
  startMinute    Int          @map("start_minute")
  endMinute      Int          @map("end_minute")

  @@index([tenantId])
  @@index([staffProfileId])
  @@map("working_hours")
}

/// A client-facing job/service template (a therapy session type, a plumbing
/// call-out type, etc.) - picked on a real Appointment (clientId set).
/// durationMinutes/price are the defaults a new Appointment is pre-filled
/// with; estimatedDurationMinutes/estimatedValue on Appointment itself can
/// then be adjusted per actual job. Split out from the formerly-shared
/// `ServiceType` table (ISSUES.md #1, 2026-10-09) - an appointment's job type
/// has a price/payment concept a shift's never did, so the two no longer
/// share one pool.
model AppointmentServiceType {
  id                 String   @id @default(uuid())
  tenantId           String   @map("tenant_id")
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name               String
  durationMinutes    Int      @map("duration_minutes")
  /// Null = no price set (e.g. police work that's never billed) - distinct from $0, which is an explicit "free".
  price              Decimal? @db.Decimal(10, 2)
  requiresPayment    Boolean  @default(false) @map("requires_payment")
  /// Inactive service types are hidden from new scheduling but kept for existing appointments that reference them.
  isActive           Boolean  @default(true) @map("is_active")
  /// Admin-configurable (Settings > Booking Widget, paid feature): whether
  /// this service type shows up as a choice on the public self-booking
  /// page/embed - separate from isActive, which just governs internal
  /// (admin/staff) scheduling. A service type can stay active for internal
  /// use while never being offered publicly. Appointment-only - the public
  /// booking widget only ever books client-facing appointments, never shifts.
  isPubliclyBookable Boolean  @default(false) @map("is_publicly_bookable")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  appointments Appointment[]

  @@index([tenantId])
  @@map("appointment_service_types")
}

/// An internal job/shift template (no client, no price - just a name and a
/// default duration, e.g. "Patrol," "Front desk"). Picked on a shift-mode
/// Appointment (clientId null) or a ScheduleTemplateShift. Split out from the
/// formerly-shared `ServiceType` table (ISSUES.md #1, 2026-10-09) - see
/// AppointmentServiceType's doc comment for why.
model ShiftServiceType {
  id              String   @id @default(uuid())
  tenantId        String   @map("tenant_id")
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name            String
  durationMinutes Int      @map("duration_minutes")
  /// Inactive job types are hidden from new scheduling but kept for existing shifts that reference them.
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  appointments           Appointment[]
  scheduleTemplateShifts ScheduleTemplateShift[]

  @@index([tenantId])
  @@map("shift_service_types")
}

/// A client/customer. Guest-first (per architecture plan) - isGuest clients
/// have no User/login; customer accounts (UserRole.CUSTOMER) are a later,
/// optional upgrade path for this record, not yet wired up.
model Client {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  email     String?
  phone     String?
  address   String?
  isGuest   Boolean  @default(true) @map("is_guest")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  appointments Appointment[]

  @@index([tenantId])
  @@map("clients")
}

/// One scheduled visit/shift/job. clientId is nullable for internal,
/// non-client-facing scheduling (e.g. a pure shift with no paying customer).
/// estimatedDurationMinutes/estimatedValue are the blue-collar "how long will
/// this job take and what will it make" fields - intentionally only
/// exposed to ADMIN/MANAGER in the UI/API layer (see
/// src/lib/auth/current-user.ts requireRole and the appointments API route),
/// not restricted at the DB/RLS level since that's a UI/role concern, not a
/// tenant-isolation one.
model Appointment {
  id                       String                  @id @default(uuid())
  tenantId                 String                  @map("tenant_id")
  tenant                   Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staffId                  String                  @map("staff_id")
  staff                    StaffProfile            @relation(fields: [staffId], references: [id], onDelete: Restrict)
  /// Which of the three calendars this row belongs to - the real source of
  /// truth for "is this a shift/appointment/custom entry" now (see isShift/
  /// isCustomEntry in SchedulingCalendar.tsx). Previously inferred purely
  /// from clientId presence; kept distinct from it because a CUSTOM entry
  /// can have a client or not depending on the tenant's Custom-form settings,
  /// so clientId alone can't distinguish SHIFT from CUSTOM anymore.
  entryKind                EntryKind               @map("entry_kind")
  /// Which named CustomCalendar this row belongs to - set if and only if
  /// entryKind is CUSTOM (a tenant can have several custom calendars; this
  /// is the real scoping key, not just a shared "custom" bucket). Cascades
  /// on delete - removing a custom calendar removes its entries, same as
  /// removing the tenant itself does for every row.
  customCalendarId         String?                 @map("custom_calendar_id")
  customCalendar           CustomCalendar?         @relation(fields: [customCalendarId], references: [id], onDelete: Cascade)
  clientId                 String?                 @map("client_id")
  client                   Client?                 @relation(fields: [clientId], references: [id], onDelete: SetNull)
  /// Exactly one of appointmentServiceTypeId/shiftServiceTypeId is ever set,
  /// picked by which service-type list was actually chosen in the form
  /// rather than strictly by entryKind - a CUSTOM entry's job-type field can
  /// pick from either list (see Settings > Calendars > "Custom form"). Not
  /// enforced at the DB level - app layer picks the right one, same "soft
  /// invariant" convention as tagId/colorKey below.
  appointmentServiceTypeId String?                 @map("appointment_service_type_id")
  appointmentServiceType   AppointmentServiceType? @relation(fields: [appointmentServiceTypeId], references: [id], onDelete: SetNull)
  shiftServiceTypeId       String?                 @map("shift_service_type_id")
  shiftServiceType         ShiftServiceType?       @relation(fields: [shiftServiceTypeId], references: [id], onDelete: SetNull)
  startTime                DateTime                @map("start_time")
  endTime                  DateTime                @map("end_time")
  status                   AppointmentStatus       @default(BOOKED)
  priceCharged             Decimal?                @map("price_charged") @db.Decimal(10, 2)
  paymentStatus            PaymentStatus           @default(UNPAID) @map("payment_status")
  estimatedDurationMinutes Int?                    @map("estimated_duration_minutes")
  estimatedValue           Decimal?                @map("estimated_value") @db.Decimal(10, 2)
  locationType             MeetingLocationType     @default(IN_PERSON) @map("location_type")
  /// Physical address when locationType is IN_PERSON, or a meeting link/platform note when ONLINE.
  location                 String?                 @map("location")
  /// Null only for a public self-service booking (source: SELF_SERVICE,
  /// created with no authenticated session) - every admin-created row still
  /// always sets this.
  createdByUserId          String?                 @map("created_by_user_id")
  source                   AppointmentSource       @default(ADMIN)
  /// Optional custom color tag (see EventTag) overriding this entry's
  /// default status-based color on the calendar.
  tagId                    String?                 @map("tag_id")
  tag                      EventTag?               @relation(fields: [tagId], references: [id], onDelete: SetNull)
  /// Optional built-in color key ("appointment"/"shift"/"completed"/
  /// "noShow"/"cancelled" - see EVENT_COLOR_KEYS in
  /// src/lib/colors/eventColors.ts) picked from the same "Color key"
  /// control tagId uses, letting an entry use one of Settings > Calendar >
  /// Event colors' built-in colors directly instead of only a custom tag.
  /// Mutually exclusive with tagId in the UI (picking one clears the
  /// other) - not enforced at the DB level, same as every other
  /// soft invariant in this app. Loses to a terminal status
  /// (CANCELLED/NO_SHOW/COMPLETED) in resolveEventColor, the same priority
  /// slot tagId's color already holds.
  colorKey                 String?                 @map("color_key")
  createdAt                DateTime                @default(now()) @map("created_at")
  updatedAt                DateTime                @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([staffId, startTime])
  @@index([clientId])
  @@index([tenantId, entryKind])
  @@index([customCalendarId])
  @@map("appointments")
}

/// Per-tenant override of what a role is allowed to do, layered on top of a
/// hardcoded default matrix (src/lib/permissions/catalog.ts). Only
/// MANAGER/SUPERVISOR/EMPLOYEE/CUSTOMER rows are meaningful here - ADMIN
/// always has every permission and is never overridable (enforced in code,
/// not the DB, since it's a business rule rather than a tenant-isolation one).
/// This is what lets a tenant ADMIN configure "what can a manager/supervisor
/// do" from the Settings page instead of it being hardcoded.
/// What a tenant-defined Role is allowed to do - a real row per (role, key)
/// pair is the only source of truth now (no hardcoded default layered under
/// it): a brand-new role simply has no rows, i.e. denies everything, until
/// an admin explicitly grants permissions from the Settings page.
model RolePermission {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roleId        String   @map("role_id")
  role          Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionKey String   @map("permission_key")
  granted       Boolean
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, roleId, permissionKey])
  @@index([tenantId])
  @@map("role_permissions")
}

/// Per-tenant setting for which roles can view which other roles' data/schedules
/// (the "admin can determine who can see who" requirement) - e.g. can a
/// Supervisor-equivalent role see a given Employee-equivalent role's
/// appointments. A missing row denies (same no-hardcoded-default convention
/// as RolePermission) - except a role always implicitly sees its own data,
/// enforced in code, never stored as a row.
model RoleVisibility {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  viewerRoleId String   @map("viewer_role_id")
  viewerRole   Role     @relation("RoleVisibilityViewer", fields: [viewerRoleId], references: [id], onDelete: Cascade)
  targetRoleId String   @map("target_role_id")
  targetRole   Role     @relation("RoleVisibilityTarget", fields: [targetRoleId], references: [id], onDelete: Cascade)
  canView      Boolean  @map("can_view")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, viewerRoleId, targetRoleId])
  @@index([tenantId])
  @@map("role_visibilities")
}

/// A reusable shift pattern (TODO.md's "reusable shift-schedule templates") -
/// built once, then applied to any target week to generate real Appointment
/// rows (shifts - clientId null), instead of rebuilding the same weekly
/// pattern from scratch every time. periodLengthDays is per-template (e.g. a
/// 7-day vs. 14-day rotation), not a tenant-wide default - each template
/// defines its own rotation length.
model ScheduleTemplate {
  id               String   @id @default(uuid())
  tenantId         String   @map("tenant_id")
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name             String
  periodLengthDays Int      @map("period_length_days")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  shifts ScheduleTemplateShift[]

  @@index([tenantId])
  @@map("schedule_templates")
}

/// One shift within a ScheduleTemplate's rotation - relative to the period
/// (dayOffset, 0-indexed) rather than tied to a real calendar date, so the
/// same template can be applied starting from any week. start/endMinute are
/// minutes since local midnight on that offset day, same convention as
/// WorkingHours.start/endMinute. Applying the template (see
/// src/modules/scheduling/templates.ts) turns each row into a real
/// Appointment with clientId null.
model ScheduleTemplateShift {
  id                 String            @id @default(uuid())
  tenantId           String            @map("tenant_id")
  tenant             Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  templateId         String            @map("template_id")
  template           ScheduleTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  staffId            String            @map("staff_id")
  staff              StaffProfile      @relation(fields: [staffId], references: [id], onDelete: Cascade)
  dayOffset          Int               @map("day_offset")
  startMinute        Int               @map("start_minute")
  endMinute          Int               @map("end_minute")
  shiftServiceTypeId String?           @map("shift_service_type_id")
  shiftServiceType   ShiftServiceType? @relation(fields: [shiftServiceTypeId], references: [id], onDelete: SetNull)
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([templateId])
  @@map("schedule_template_shifts")
}
